# ============================================================
#  Root environment — shared by the Salesforce ETL
#  (salesforce_to_postgres.py) and the FastAPI backend
#  (backend/app/config.py reads this file first).
#
#  Copy to `.env` and fill in real values.  The real `.env` is
#  git-ignored and must NEVER be committed.
# ============================================================

# --- Salesforce (ETL source) ---
SF_USERNAME=your.login@example.com
SF_PASSWORD=your-salesforce-password
SF_SECURITY_TOKEN=your-salesforce-security-token
SF_INCREMENTAL=true          # true = only pull records changed since last SystemModstamp
SYNC_MODE=incremental        # incremental | full

# --- PostgreSQL (replica target + backend read model) ---
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=salesforce_db_v2
PG_USERNAME=postgres
PG_PASSWORD=your-postgres-password
