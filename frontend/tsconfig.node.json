{
  "compilerOptions": {
    "composite": true,
    // Emit build artifacts out of the project root: a compiled vite.config.js
    // next to vite.config.ts SHADOWS it (Vite loads .js before .ts) -- this
    // silently pinned the dev proxy to a stale target once (2026-08-21).
    "outDir": "./node_modules/.tmp/tsconfig.node",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "include": ["vite.config.ts"]
}
