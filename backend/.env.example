# Backend-specific settings. DB credentials are read from the project-root .env
# (the same file the ETL uses). Only override here if you want backend-only values.

# JWT signing key -- MUST be replaced with a long random string in production.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-change-me

# Access token lifetime (minutes). Default = 12 hours.
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Comma-separated list of allowed frontend origins (Vite dev server default below)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
